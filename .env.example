# Chave pública do Supabase. Ela pode ir para o navegador.
# A segurança está nas políticas RLS e nas funções do banco.
# Nunca coloque aqui a service_role nem a senha do Postgres.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica

# Use / no computador. No GitHub Pages, use /nome-do-repositorio/
VITE_BASE_PATH=/
